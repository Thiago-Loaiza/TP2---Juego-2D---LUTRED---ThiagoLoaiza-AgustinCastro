
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

#begin And the rest was silence - Grace OST.mp3
/importer:Mp3Importer
/processor:SongProcessor
/processorParam:Quality=Best
/build:And the rest was silence - Grace OST.mp3

#begin Effects/EstrellaParry-Sheet.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=255,0,255,255
/processorParam:ColorKeyEnabled=True
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/processorParam:Version=3.8.5.1
/build:Effects/EstrellaParry-Sheet.png

#begin Fonts/PMingLiU Regular/Font.fnt
/copy:Fonts/PMingLiU Regular/Font.fnt

#begin Fonts/PMingLiU Regular/Font_0.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:Fonts/PMingLiU Regular/Font_0.png

#begin Fonts/PMingLiU Regular/PMingLiU Regular.ttf
/importer:FontImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/processorParam:Version=3.8.5.1
/build:Fonts/PMingLiU Regular/PMingLiU Regular.ttf

#begin Music/And the rest was silence - Grace OST.mp3
/importer:Mp3Importer
/processor:SongProcessor
/processorParam:Quality=Best
/processorParam:Version=3.8.5.1
/build:Music/And the rest was silence - Grace OST.mp3

